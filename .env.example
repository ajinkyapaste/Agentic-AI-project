# ===================================================
# Sales Intelligence Platform - Environment Variables
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Admin Initialization Credentials (used by seed script)
# Change these before deploying to production!
ADMIN_USERNAME=ajinkya
ADMIN_PASSWORD=12345678
ADMIN_EMAIL=admin@salesintelligence.local

# JWT Secret for Session & API Token Authentication
JWT_SECRET=super-secret-sales-intelligence-jwt-token-key-2026-change-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local or cloud PostgreSQL (Neon, Supabase, Render, AWS RDS):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sales_intelligence?schema=public"

# Optional: Set to 'sqlite' for local offline testing if PostgreSQL is not running
# DB_PROVIDER=postgresql

# File Upload Settings
MAX_FILE_SIZE_MB=25
UPLOAD_DIR="./uploads"

# Optional AI / Python Forecasting Engine Bridge
PYTHON_SERVICE_URL="http://localhost:8000"

